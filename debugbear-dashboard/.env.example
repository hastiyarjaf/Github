# DebugBear API Configuration
# Get your API key from: https://www.debugbear.com/account/api-keys
DEBUGBEAR_API_KEY=your_actual_api_key_here

# OpenAI API Configuration (for AI features)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Google AI Studio / Gemini API Configuration (for advanced AI features)
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Server Configuration
PORT=5000
NODE_ENV=development

# Client Configuration
CLIENT_URL=http://localhost:3000

# Optional: Set the API base URL (defaults to DebugBear's production API)
# DEBUGBEAR_API_BASE_URL=https://www.debugbear.com/api/v1
