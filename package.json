{
  "name": "wedonet-platform",
  "version": "1.0.0",
  "description": "WeDoNet - A secure, AI-powered platform for talent management and real-time collaboration",
  "private": true,
  "workspaces": [
    "wedonet-frontend",
    "wedonet-backend",
    "debugbear-dashboard"
  ],
  "scripts": {
    "start": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "start:backend": "cd wedonet-backend && npm start",
    "start:frontend": "cd wedonet-frontend && npm start",
    "start:dashboard": "cd debugbear-dashboard && npm start",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "cd wedonet-frontend && npm run build",
    "build:backend": "cd wedonet-backend && npm run build",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "cd wedonet-backend && npm test",
    "test:frontend": "cd wedonet-frontend && npm test -- --watchAll=false",
    "test:e2e": "playwright test",
    "lint": "npm run lint:backend && npm run lint:frontend",
    "lint:backend": "cd wedonet-backend && npm run lint",
    "lint:frontend": "cd wedonet-frontend && npm run lint",
    "audit": "npm audit && cd wedonet-backend && npm audit && cd ../wedonet-frontend && npm audit",
    "security-scan": "npm run audit && npm run test",
    "dev": "docker-compose up",
    "dev:down": "docker-compose down",
    "setup": "npm install && npm run setup:backend && npm run setup:frontend",
    "setup:backend": "cd wedonet-backend && npm install",
    "setup:frontend": "cd wedonet-frontend && npm install",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.1",
    "concurrently": "^8.2.2",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "pre-push": "npm run security-scan"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "keywords": [
    "wedonet",
    "talent-management", 
    "real-time",
    "ai-powered",
    "secure",
    "collaboration"
  ],
  "author": "WeDoNet Team",
  "license": "MIT"
}