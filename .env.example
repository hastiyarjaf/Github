# WeDoNet Platform Environment Configuration
# Copy this file to .env for Docker Compose configuration

# Security Configuration - CHANGE THESE IN PRODUCTION!
JWT_ACCESS_SECRET=dev-access-secret-key-at-least-32-characters-long-for-development-only
JWT_REFRESH_SECRET=dev-refresh-secret-key-at-least-32-characters-long-for-development-only
REDIS_PASSWORD=development
ADMIN_PASSWORD=AdminPassword123!

# API Keys (optional)
DEBUGBEAR_API_KEY=
OPENAI_API_KEY=

# Database Configuration
DB_FILENAME=/app/data/database.db

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Development Ports
FRONTEND_PORT=3000
BACKEND_PORT=3001
DASHBOARD_PORT=5000
REDIS_PORT=6379
DB_ADMIN_PORT=8080